# =====================================================================
# Closer to the Father: environment variables
# Copy this file to .env.local for local testing, or paste each value
# into Vercel > Project > Settings > Environment Variables.
# Lines starting with # are comments. Never share the "secret" values.
# =====================================================================

# ---------------------------------------------------------------------
# Site address (required in production)
# The full web address of your site, with no slash at the end.
# Used for links in emails, share buttons, the sitemap, and preview images.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://closertothefather.org

# ---------------------------------------------------------------------
# Supabase database (required for a live site)
# Supabase > Project Settings > API.
# If these are empty the site runs in DEMO MODE with sample data kept in
# memory. Demo mode is only for previewing; nothing is saved.
# ---------------------------------------------------------------------
# "Project URL"
SUPABASE_URL=
# "service_role" secret key. SECRET: server only. Never put this in a
# variable that starts with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Admin dashboard (required)
# The password you type at /admin. Use at least 12 characters.
# ---------------------------------------------------------------------
ADMIN_PASSWORD=
# A long random string used to sign the admin login cookie. SECRET.
# Generate one at https://generate-secret.vercel.app/32 or run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------
# Cloudflare Turnstile spam protection (strongly recommended, free)
# Cloudflare dashboard > Turnstile > Add widget. Add your domain.
# If both are empty, forms work without the check (fine for testing,
# not recommended for a live site).
# ---------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SECRET
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------
# Email through Resend (optional, free tier: 3,000 emails a month)
# resend.com > API Keys. You must verify your domain in Resend before
# you can email people other than yourself.
# If RESEND_API_KEY is empty, no emails are sent (they are logged instead).
# ---------------------------------------------------------------------
# SECRET
RESEND_API_KEY=
# The "from" address. Must be on the domain you verified in Resend.
EMAIL_FROM=Closer to the Father <prayer@closertothefather.org>
# Where new-submission alerts and contact messages are sent.
ADMIN_EMAIL=
# Set to "off" to stop admin alert emails. Anything else keeps them on.
ADMIN_ALERTS=on

# ---------------------------------------------------------------------
# Scheduled job (required if you use email)
# Vercel sends this automatically to /api/cron/daily once a day.
# Any long random string. SECRET.
# ---------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------
# Privacy salt (optional)
# Visitor IP addresses are never stored. They are scrambled with this
# value first so the site can slow down spammers. Any long random
# string. SECRET. If empty, ADMIN_SESSION_SECRET is used.
# ---------------------------------------------------------------------
HASH_SALT=
